# ============================================================================
# KONFIGURASI ENVIRONMENT SIPDS - SMP BHINNEKA TUNGGAL IKA
# ============================================================================

# 1. SUPABASE CLIENT (Frontend & Backend)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

# 2. SUPABASE SERVICE ROLE KEY (HANYA DI SERVER / EDGE FUNCTION - RAHASIA)
# Digunakan khusus di server untuk memetakan login NISN Orang Tua ke Supabase Auth,
# mengaktifkan akun orang tua, dan melakukan reset password oleh Admin.
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# 3. GEMINI API & APP URL (Disediakan oleh Runtime AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
